---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getAllDocs, GROUP_LABELS } from '../../lib/docs';

const docs = await getAllDocs();
const suggestions = ['建模', '渲染 Cycles', '几何节点', '从源码构建', '扩展', '许可证'];
---

<BaseLayout
  title="搜索"
  description="站内搜索 Blender 中文站全部文档：输入关键词即可检索手册与开发者指南。"
>
  <section class="container-page pt-14 lg:pt-20">
    <p class="kicker text-brand-500">站内搜索 · Search</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-5xl">搜索全部文档</h1>
    <p class="mt-4 max-w-2xl leading-8 text-zinc-400">
      已索引 {docs.length} 篇文章（{GROUP_LABELS.manual}与{GROUP_LABELS.dev}）。按 <kbd class="keycap">/</kbd> 可随时唤起本页。
    </p>

    <div class="mt-8 max-w-3xl">
      <label for="search-input" class="sr-only">搜索关键词</label>
      <div class="relative">
        <Icon name="search" size={22} class="pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-zinc-500" />
        <input
          id="search-input"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder="试试“渲染”“修改器”“GPLv3”…"
          class="w-full rounded-2xl border border-white/12 bg-ink-900/80 py-4 pl-13 pr-14 text-[17px] text-zinc-100 placeholder:text-zinc-600 focus:border-brand-500/60 focus:outline-none focus:ring-2 focus:ring-brand-500/25"
        />
        <span
          id="result-count"
          class="absolute right-4 top-1/2 -translate-y-1/2 rounded-full border border-white/10 px-2.5 py-1 font-mono text-[11.5px] font-semibold text-zinc-500"
        ></span>
      </div>

      <div id="quick" class="mt-4 flex flex-wrap items-center gap-2" aria-label="热门搜索">
        <span class="text-xs text-zinc-600">热门：</span>
        {suggestions.map((s) => (
          <button
            type="button"
            data-q={s}
            class="rounded-full border border-white/10 px-3 py-1.5 text-[13px] text-zinc-400 transition-colors hover:border-brand-500/50 hover:text-brand-300"
          >
            {s}
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page pb-16 pt-8">
    <div id="search-status" role="status" class="text-sm text-zinc-500"></div>
    <ul id="search-results" class="mt-6 space-y-3"></ul>
    <noscript>
      <p class="mt-8 rounded-2xl border border-white/8 bg-white/[0.03] p-6 text-sm leading-7 text-zinc-400">
        本站搜索需要 JavaScript。你可以直接浏览
        <a href="/docs/" class="font-medium text-brand-300 hover:underline">文档中心</a>的全部文章。
      </p>
    </noscript>
  </section>
</BaseLayout>

<script>
  const GROUP_LABELS = { manual: '使用手册', dev: '开发者文档' };

  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const status = document.getElementById('search-status');
  const results = document.getElementById('search-results');
  const count = document.getElementById('result-count');
  const quick = document.getElementById('quick');

  let index: any[] = [];
  let query = '';

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  function escapeRe(s: string) {
    return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function highlight(text: string, tokens: string[]) {
    const escText = esc(text);
    if (!tokens.length) return escText;
    const re = new RegExp(`(${tokens.map(escapeRe).join('|')})`, 'ig');
    return escText.replace(re, '<mark>$1</mark>');
  }

  function snippetFor(item: any, tokens: string[]) {
    const hay = item.text;
    let best = -1;
    for (const t of tokens) {
      const i = hay.toLowerCase().indexOf(t);
      if (i !== -1 && (best === -1 || i < best)) best = i;
    }
    const start = Math.max(0, (best === -1 ? 0 : best) - 46);
    const slice = hay.slice(start, start + 150).trim();
    return (start > 0 ? '…' : '') + slice + (start + 150 < hay.length ? '…' : '');
  }

  function score(item: any, tokens: string[]): number {
    let s = 0;
    for (const t of tokens) {
      const title = item.title.toLowerCase();
      if (title.includes(t)) s += 100;
      const tagline = item.tagline.toLowerCase();
      if (tagline.includes(t)) s += 30;
      const desc = item.description.toLowerCase();
      if (desc.includes(t)) s += 15;
      for (const h of item.headings) if (h.toLowerCase().includes(t)) s += 12;
      const body = item.text.toLowerCase();
      let i = -1;
      let n = 0;
      while ((i = body.indexOf(t, i + 1)) !== -1 && n < 20) n++;
      s += n;
    }
    return s;
  }

  function run(instant = false) {
    const q = (input?.value ?? '').trim();
    if (q === query && !instant) return;
    query = q;
    const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);

    if (!status || !results || !count) return;
    if (!tokens.length) {
      status.textContent = '输入关键词开始搜索。';
      status.className = 'text-sm text-zinc-500';
      results.innerHTML = '';
      count.textContent = '';
      return;
    }
    const scored = index
      .map((item) => ({ item, s: score(item, tokens) }))
      .filter((x) => x.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 12);

    count.textContent = String(scored.length);
    results.innerHTML = '';
    if (!scored.length) {
      status.textContent = `没有找到与“${query}”相关的内容，换个词试试，或去官方中文手册检索。`;
      status.className = 'text-sm text-zinc-500';
      return;
    }
    status.textContent = `找到 ${scored.length} 条结果`;
    status.className = 'text-sm text-zinc-400';

    for (const { item, s } of scored) {
      const li = document.createElement('li');
      li.className = 'search-result';
      const snippet = snippetFor(item, tokens);
      li.innerHTML = `
        <a href="${item.href}" class="group block rounded-2xl border border-white/8 bg-white/[0.03] p-5 transition-all hover:-translate-y-0.5 hover:border-brand-500/45 hover:bg-brand-500/[0.05]">
          <div class="flex items-center gap-2.5">
            <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-brand-400">${GROUP_LABELS[item.group as keyof typeof GROUP_LABELS]}</span>
            <span class="font-mono text-[11px] text-zinc-600">#${String(item.order).padStart(2, '0')}</span>
            <span class="ml-auto text-[11px] text-zinc-600">${esc(item.updated)}</span>
          </div>
          <h2 class="mt-2 text-[17px] font-bold text-zinc-100 transition-colors group-hover:text-brand-300">${highlight(item.title, tokens)}</h2>
          <p class="mt-1 text-[13.5px] leading-6 text-zinc-500">${highlight(item.description, tokens)}</p>
          <p class="mt-2.5 text-[13px] leading-6 text-zinc-400">${highlight(snippet, tokens)}</p>
          <span class="mt-3 inline-flex items-center gap-1.5 text-[12.5px] font-medium text-zinc-600 transition-colors group-hover:text-brand-300">匹配度 ${Math.round(s)}<span class="text-zinc-700">·</span>打开文档 →</span>
        </a>`;
      results.appendChild(li);
    }
  }

  let timer: ReturnType<typeof setTimeout> | undefined;
  input?.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => run(), 120);
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === '/') {
      e.preventDefault();
      return;
    }
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
    const items = Array.from(results?.querySelectorAll('.search-result a') ?? []);
    if (!items.length) return;
    e.preventDefault();
    const current = items.findIndex((a) => a === document.activeElement);
    const next = e.key === 'ArrowDown' ? Math.min(items.length - 1, current + 1) : Math.max(0, current === -1 ? items.length - 1 : current - 1);
    (items[next] as HTMLElement).focus();
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const active = document.activeElement as HTMLElement | null;
      if (active && active.closest('#search-results')) return; // 已在结果上
      const first = results?.querySelector('.search-result a') as HTMLAnchorElement | null;
      first?.click();
    }
  });

  quick?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-q]') as HTMLButtonElement | null;
    if (!btn || !input) return;
    input.value = btn.dataset.q ?? '';
    run(true);
  });

  fetch('/search.json')
    .then((r) => {
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      return r.json();
    })
    .then((data) => {
      index = data;
      if (input) {
        const initial = new URLSearchParams(window.location.search).get('q') ?? '';
        input.value = initial;
        input.focus();
        if (initial) run(true);
        else if (status) {
          status.textContent = `已索引 ${index.length} 篇文章，输入关键词开始搜索。`;
          status.className = 'text-sm text-zinc-400';
        }
      }
    })
    .catch(() => {
      if (status) {
        status.textContent = '搜索索引加载失败。可直接浏览文档中心，或稍后重试。';
        status.className = 'text-sm text-amber-300';
      }
    });
</script>
